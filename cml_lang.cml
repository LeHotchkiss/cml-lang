version 100

base_target {
    depends []
    depends_ex []

    class "exe"

    includes [ ]
    source [ ]
    lib [ ]

    link [ ]
    link_shared [ ]

    compiler "g++"

    cc_args ["-std=c++17" "-fno-exceptions"]
    ld_args [ ]

    out "test"
}

targets {
    main {
        concat "base_target"

        depends_ex [
            {
                path "hotchlib/hotchlib.cml"
                target "main"
            }
        ]

        class "static"

        includes [
            "src" "include" "."
            "hotchlib/include"
        ]

        source [
            "src/*.cpp"
        ]

        lib [
            "hotchlib"
        ]

        link [
            "libhotch.a"
        ]

        cc_args [ ]

        out "libcml.a"
    }

    main_debug {
        concat "targets.main"

        cc_args ["-g3"]
    }

    main_pic {
        concat "base_target"

        depends_ex [
            {
                path "hotchlib/hotchlib.cml"
                target "main_pic"
            }
        ]

        class "static"

        includes [
            "src" "include" "."
            "hotchlib/include"
        ]

        source [
            "src/*.cpp"
        ]

        lib [
            "hotchlib"
        ]

        link [
            "libhotch.pic.a"
        ]

        cc_args [ "-O2" "-fPIC" ]

        out "libcml.pic.a"
    }

    shared {
        concat "base_target"

        depends_ex [
            {
                path "hotchlib/hotchlib.cml"
                target "shared"
            }
        ]

        class "shared"

        includes [
            "src" "include" "."
            "hotchlib/include"
        ]

        source [
            "src/*.cpp"
        ]

        lib [
            "hotchlib"
        ]

        link [
            "libhotch.pic.a"
        ]

        cc_args [ "-O2" ]

        out "libcml.so"
    }

    test {
        concat "base_target"

        depends [
            "main_debug"
        ]

        class "exe"

        source ["test.cpp"]

        includes [
            "." "include"
            "hotchlib/include"
        ]

        lib [
            "."
            "hotchlib"
        ]

        link ["libcml.a" "libhotch.a"]

        cc_args ["-g3"]

        out "cmltest"
    }
}
