version 100

base_target {
    depends []
    depends_ex []

    class "exe"

    includes [ ]
    source [ ]
    lib [ ]

    link [ ]
    link_shared [ ]

    compiler "g++"

    cc_args [ ]
    ld_args [ ]

    out "test"
}

targets {
    zlib {
        concat "base_target"

        class "static"

        includes ["zlib"]

        source [
            "zlib/adler32.c"     "zlib/compress.c"
            "zlib/crc32.c"       "zlib/deflate.c"
            "zlib/gzclose.c"     "zlib/gzlib.c"
            "zlib/gzread.c"      "zlib/gzwrite.c"
            "zlib/inflate.c"     "zlib/infback.c"
            "zlib/inftrees.c"    "zlib/inffast.c"
            "zlib/trees.c"       "zlib/uncompr.c"
            "zlib/zutil.c"
        ]

        compiler "gcc"

        cc_args [
            "-O2"
            "-D_LARGEFILE64_SOURCE=1"
        ]

        out "libz.a"
    }

    main {
        concat "base_target"

        depends_ex [
            {
                path "hotchlib/hotchlib.cml"
                target "main"
            }
        ]

        depends [
            "zlib"
        ]

        class "static"

        includes [
            "src" "include" "."
            "hotchlib/include"
        ]

        source [
            "src/*.cpp"
        ]

        lib [
            "hotchlib"
        ]

        link [
            "libhotch.a"
        ]

        cc_args ["-std=c++17" "-fno-exceptions"]

        out "libcml.a"
    }

    main_debug {
        concat "targets.main"

        cc_args ["-g3"]
    }

    main_pic {
        concat "base_target"

        depends_ex [
            {
                path "hotchlib/hotchlib.cml"
                target "main_pic"
            }
        ]

        depends [
            "zlib"
        ]

        class "static"

        includes [
            "src" "include" "."
            "hotchlib/include"
        ]

        source [
            "src/*.cpp"
        ]

        lib [
            "hotchlib"
        ]

        link [
            "libhotch.pic.a"
        ]

        cc_args [ "-O2" "-fPIC" "-std=c++17" "-fno-exceptions" ]

        out "libcml.pic.a"
    }

    shared {
        concat "base_target"

        depends_ex [
            {
                path "hotchlib/hotchlib.cml"
                target "shared"
            }
        ]

        depends [
            "zlib"
        ]

        class "shared"

        includes [
            "src" "include" "."
            "hotchlib/include"
        ]

        source [
            "src/*.cpp"
        ]

        cc_args [ "-O2" ]

        out "libcml.so"
    }

    test {
        concat "base_target"

        depends [
            "main_debug"
        ]

        class "exe"

        source ["test.cpp"]

        includes [
            "." "include"
            "hotchlib/include"
        ]

        lib [
            "."
            "hotchlib"
        ]

        link ["libcml.a" "libhotch.a"]

        cc_args ["-g3"]

        out "cmltest"
    }
}
